
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, m;
        cin >> n >> m;

        vector<int> arr(n);

        for (int i = 0; i < n; i++) {
            cin >> arr[i];
        }

        
        sort(arr.begin(), arr.end());

        int people = 0;
        int ans = 0;

        for (int i = 0; i < n; i++) {

            people += arr[i];

            
            int handshakes = people * (people - 1) / 2;

            if (handshakes <= m) {
                ans++;
            }
            else {
                break;
            }
        }

        cout << ans << endl;
    }

    return 0;
}
