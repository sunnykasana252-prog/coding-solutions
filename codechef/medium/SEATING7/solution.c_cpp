#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while(T--) {
        int N, M, K;
        cin >> N >> M >> K;

        vector<int> seat(N + 1, 0);

        // Mark already occupied seats
        for(int i = 0; i < M; i++) {
            int x;
            cin >> x;
            seat[x] = 1;
        }

        // Find seats for K new people
        for(int person = 0; person < K; person++) {

            for(int i = 1; i <= N; i++) {

                if(seat[i] == 0) {
                    cout << i << " ";
                    seat[i] = 1;
                    break;
                }
            }
        }

        cout << endl;
    }

    return 0;
}