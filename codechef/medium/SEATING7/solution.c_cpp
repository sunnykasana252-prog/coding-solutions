#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int a, b, c;
        int d, e;

        cin >> a >> b >> c >> d >> e;

        for(int i = 1; i <= a; i++) {

            if(i == d || i == e)
                continue;

            if(c == 0)
                break;

            cout << i << " ";
            c--;
        }

        cout << endl;
    }
}