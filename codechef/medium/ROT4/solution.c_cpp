
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        string s;
        cin >> s;

        int count = 0;

        for (int i = 0; i < n; i++) {

            int x = s[(i + n - 2) % n] - '0';
            int y = s[(i + n - 1) % n] - '0';

            int num = x * 10 + y;

            if (num % 4 == 0) {
                count++;
            }
        }

        cout << count << endl;
    }

    return 0;
}
