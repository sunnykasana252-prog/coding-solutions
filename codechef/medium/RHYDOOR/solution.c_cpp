#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        string s;
        cin >> s;

        int c = 0;
        int ans = 0;

        for (int i = 0; i < n; i++) {
            if (s[i] == s[i+1]) {
                c++;
            }
            else {
                c = 0;
            }

            if (c == 2) {
                ans++;
                c = 0;
                i++;
            }
        }

        cout << ans << endl;
    }

    return 0;
}