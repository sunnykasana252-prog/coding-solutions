       #include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        string s;
        cin >> s;

        int c = 0;

        for (int i = 0; i < n;) {
            int j = i;

            while (j < n && s[i] == s[j]) {
                j++;
            }

            if (j - i >= 3) {
                c++;
            }

            i = j;
        }

        cout << c << endl;
    }

    return 0;
}
