#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        int c = 0;

        for (int i = 0; i + 2 < s.size(); i++) {
            if (s[i] == s[i+1] && s[i] == s[i+2]) {
                c++;
                i += 2;
            }
        }

        cout << c << endl;
    }

    return 0;
}