
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, d;
        cin >> n >> d;

        int a[100], b[100];

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        for (int i = 0; i < n; i++) {
            cin >> b[i];
        }

        int cost1 = d;
        int cost2 = d;
        int cost3 = 2 * d;

        for (int i = 0; i < n; i++) {
            cost1 += a[i];
            cost2 += b[i];
            cost3 += min(a[i], b[i]);
        }

        cout << min({cost1, cost2, cost3}) << endl;
    }

    return 0;
}
