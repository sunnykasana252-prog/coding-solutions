
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        vector<int> a(n);

        for(int i = 0; i < n; i++) {
            cin >> a[i];
        }

        int maxi = 0;

        for(int i = 0; i < n; i++) {
            int odd = 0;

            for(int j = i; j < n; j++) {

                if(a[j] % 2 != 0) {
                    odd++;
                }

                if(odd % 2 == 0) {
                    maxi = max(maxi, j - i + 1);
                }
            }
        }

        cout << maxi << endl;
    }

    return 0;
}
